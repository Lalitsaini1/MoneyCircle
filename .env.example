# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The live URL where this application is hosted.
APP_URL="https://moneycircle-public.vercel.app"

# VITE_SITE_URL: Public frontend website origin used for canonical, referral, share, and auth redirect URLs.
VITE_SITE_URL="https://moneycircle-public.vercel.app"

# PAYMENT_WEBHOOK_SECRET: Server-side HMAC-SHA256 key for verifying UPI payment gateway webhooks.
PAYMENT_WEBHOOK_SECRET=
