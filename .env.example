# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The live URL where this application is hosted.
APP_URL="https://moneycircle-public.vercel.app"

# VITE_SITE_URL: Public frontend website origin used for canonical, referral, share, and auth redirect URLs.
VITE_SITE_URL="https://moneycircle-public.vercel.app"

# PAYMENT_WEBHOOK_SECRET: Server-side HMAC-SHA256 key for verifying UPI payment gateway webhooks.
PAYMENT_WEBHOOK_SECRET=

# Production Firebase Web SDK overrides (required on Vercel for project moneycircle-5aa03;
# otherwise Vite falls back to firebase-applet-config.json).
# Copy values from Firebase Console -> moneycircle-5aa03 -> Project Settings -> Your apps (Web app):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=moneycircle-5aa03.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=moneycircle-5aa03
# VITE_FIREBASE_STORAGE_BUCKET=moneycircle-5aa03.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
