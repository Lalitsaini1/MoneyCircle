        "bankIfsc": {
          "type": "string",
          "maxLength": 16
        },
        "bankName": {
          "type": "string",
          "maxLength": 100
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi"]
        },
        "isBlocked": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": ["USER", "ADMIN"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "referralCode", "isBlocked", "role", "createdAt", "updatedAt"]
    },
