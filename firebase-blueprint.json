      "title": "User",
      "description": "Registered MoneyCircle platform member profile and payout preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "referralCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "referredBy": {
          "type": "string",
          "maxLength": 128
        },
        "upiId": {
          "type": "string",
          "maxLength": 100
        },
        "bankAccountHolder": {
          "type": "string",
          "maxLength": 100
        },
        "bankAccountNumber": {
          "type": "string",
          "maxLength": 34
